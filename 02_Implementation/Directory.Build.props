<Project>

  <!-- Shared MSBuild properties for every project under 02_Implementation/. -->

  <PropertyGroup>
    <!--
      Product version, shared by all components. The service reports it as
      EagleEye_vMAJOR.MINOR and the Windows installer uses it as its version.
    -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <Product>EagleEye</Product>
    <Company>EagleEye</Company>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Two-machine setup (ADR-007): Windows-only projects (Service, TrayClient) are built on
      the Windows Developer Machine only, but the solution must still load and restore in the
      IDE on the MacBook. scripts/build.ps1 decides what is actually built on each host.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
