<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Target frameworks depend on the build host (ADR-007, ADR-019):
        Windows Developer Machine -> Windows desktop
        MacBook                   -> macOS (Mac Catalyst)
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>EagleEye.ParentApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationTitle>EagleEye</ApplicationTitle>
    <ApplicationId>com.adlemich.eagleeye</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The product version from Directory.Build.props (FR-APP-092, US-002 AC-3). -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <!-- Localization (NFR-L-011): German is the neutral/default language, English is a satellite. -->
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- macOS -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">26.0</SupportedOSPlatformVersion>
    <!-- Windows: the SDK requires the API minimum to be at most the TFM version (19041). Windows 11 is
         enforced by the installer (parentapp-setup.iss, MinVersion=10.0.22000). -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    Windows: unpackaged, self-contained (.NET runtime and Windows App SDK included), win-x64,
    installed per user by installer/windows/parentapp-setup.iss (ADR-009).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Resources\AppIcon\eagleeye.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Mac Catalyst: the .NET maccatalyst pack (27.0.x) requires exactly Xcode 27.0; the MacBook has
    Xcode 27.1 (minor update, same SDK major). Skip the exact-version check so the build runs
    (dev-environments.md §5, CR-001 §6.2). Re-check after each Xcode or workload update and remove
    this property once the pack matches the installed Xcode.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- ADR-020 §3: managed HttpClientHandler, so the trust callback of ParentHubClient runs as on Windows (no ATS). -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <!-- Apple Silicon only (requirements §9.4, US-007 G-18): no universal build, no .pkg. -->
    <RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the EagleEye eye motif of the tray client. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1E7B3A" />
    <!-- Trash can of the Rules page (US-005), one variant per theme (AppThemeBinding). -->
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EagleEye.ParentApp.Core\EagleEye.ParentApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- DPAPI for the token on Windows (MAUI SecureStorage needs package identity, ADR-009). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

</Project>
