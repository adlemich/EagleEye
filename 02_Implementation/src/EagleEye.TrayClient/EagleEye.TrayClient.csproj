<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>UI\Resources\eagleeye.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EagleEye.Shared\EagleEye.Shared.csproj" />
  </ItemGroup>

  <!-- Package versions to be pinned by DEV agent during first user story implementation -->
  <ItemGroup>
    <!-- <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="x.x.x" /> -->
  </ItemGroup>

</Project>
