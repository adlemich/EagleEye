+namespace EagleEye.ParentApp.Platforms.MacCatalyst;
+
+// TEMPORARY first-light probe (US-007): exercises the real MacKeychainSecretStore. Not committed to src/.
+internal static class KeychainProbe
+{
+    public static void Run()
+    {
+        var store = new MacKeychainSecretStore();
+        try
+        {
+            store.SetAsync("probe-store", "value-1").GetAwaiter().GetResult();
+            var r1 = store.GetAsync("probe-store").GetAwaiter().GetResult();
+            store.SetAsync("probe-store", "value-2").GetAwaiter().GetResult();
+            var r2 = store.GetAsync("probe-store").GetAwaiter().GetResult();
+            store.RemoveAsync("probe-store").GetAwaiter().GetResult();
+            var r3 = store.GetAsync("probe-store").GetAwaiter().GetResult();
+            store.RemoveAsync("probe-store").GetAwaiter().GetResult();
+            Console.WriteLine($"KCPROBE store: first={r1 == "value-1"} overwrite={r2 == "value-2"} afterRemove={r3 is null}");
+        }
+        catch (Exception ex)
+        {
+            Console.WriteLine("KCPROBE store exception " + ex.GetType().Name + ": " + ex.Message);
+        }
+
+        Console.Out.Flush();
+    }
+}
