{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EagleEye.Service (Windows, console mode)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build (Debug)",
      "program": "${workspaceFolder}/src/EagleEye.Service/bin/Debug/net10.0-windows/win-x64/EagleEye.Service.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/EagleEye.Service",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "EagleEye.Service (Windows, attach to installed service)",
      "type": "coreclr",
      "request": "attach",
      "processName": "EagleEye.Service.exe"
    },
    {
      "name": "EagleEye.TrayClient (Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build (Debug)",
      "program": "${workspaceFolder}/src/EagleEye.TrayClient/bin/Debug/net10.0-windows/win-x64/EagleEye.TrayClient.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/EagleEye.TrayClient",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "EagleEye.ParentApp (MAUI: Windows / Android on Windows, macOS on MacBook)",
      "type": "maui",
      "request": "launch",
      "preLaunchTask": "maui: Build"
    }
  ]
}
